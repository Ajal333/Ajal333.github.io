---
import Base from '../layouts/Base.astro';

const title = 'Ajal P · Apps people actually use';
const description =
  'I’m Ajal P, a full-stack engineer and two-time co-founder. CTO at Zorest, where our health apps Macro and Cradle have passed 100K users. Before that, Product Engineer at XENA Intelligence (Techstars ’22). Kerala, India.';

const stack = [
  { name: 'TypeScript', note: 'Most of what I write, front and back.' },
  { name: 'React and React Native', note: 'Every Zorest app and the XENA dashboards.' },
  { name: 'Node, NestJS and FastAPI', note: 'REST services with OpenAPI specs.' },
  { name: 'PostgreSQL and MongoDB', note: 'Plus an AWS lakehouse on S3, Athena and RDS.' },
  { name: 'LLM APIs and agents', note: 'Rate limits, cost control, provider fallbacks, MCP.' },
  { name: 'AWS and GCP', note: 'ECS, Cloud Run, Docker, infrastructure as code, CI/CD.' },
  { name: 'Queues and Airflow', note: 'Async jobs, orchestration, observability, tests.' },
  { name: 'Flutter', note: 'Cross-platform apps alongside React Native.' },
  { name: 'Python', note: 'Data work and the odd service.' },
];
---

<Base title={title} description={description}>
  <a class="skip" href="#work">Skip to the work</a>

  <div class="page">
    <div class="line" aria-hidden="true"></div>
    <div class="pulse" aria-hidden="true"></div>

    <header class="top">
      <a class="top__mark" href="#top">Ajal P</a>
      <nav class="top__nav" aria-label="Sections">
        <a class="link" href="#work">Work</a>
        <a class="link" href="#stack">Stack</a>
        <a class="link" href="#contact">Contact</a>
      </nav>
      <a class="button top__cta" href="mailto:ajal.p1999@gmail.com?subject=Hello%20Ajal">Email me</a>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="statement">
        <h1 class="hero__statement lines" id="statement">
          <span class="line-mask"><span data-line style="--i:0">Apps people</span></span>
          <span class="line-mask"><span data-line style="--i:1">actually use.</span></span>
        </h1>
        <p class="hero__intro" data-load>I’m Ajal, a full-stack engineer from Kerala, India. These days I run engineering at Zorest.</p>
        <a class="button hero__cta" href="mailto:ajal.p1999@gmail.com?subject=Hello%20Ajal" data-load style="--d:620ms">Email me</a>
      </section>

      <section class="nodes" id="work" aria-labelledby="work-h">
        <h2 class="head nodes__h" id="work-h" data-reveal>Where I’ve worked</h2>
        <ol class="nodes__list">
          <li class="node is-now" data-node data-reveal style="--i:0">
            <div class="node__left">
              <span class="node__years">2025 to now</span>
              <span class="node__dur">1 yr 6 mo</span>
            </div>
            <span class="node__dot" aria-hidden="true"></span>
            <div class="node__body">
              <h3 class="node__h"><button class="node__toggle" type="button" aria-expanded="true" aria-controls="node-zorest">Zorest</button> <span class="node__role">Co-founder and CTO</span></h3>
              <p class="node__lead">An app studio I co-founded. I own the architecture, the engineering and every release.</p>
              <div class="node__more" id="node-zorest">
                <div class="node__inner">
                  <p>Our apps have passed <b class="fig" data-count="100" data-suffix="K+">100K+</b> people and average <b class="fig" data-count="4.9" data-dec="1">4.9</b> out of 5 in the stores. Most of my week goes into the AI features and keeping everything running smoothly.</p>
                  <dl class="apps">
                    <div>
                      <dt><a class="link" href="https://macro.zorest.com" target="_blank" rel="noopener noreferrer">Macro</a></dt>
                      <dd>An AI nutrition app for iOS and Android. Take a photo of your meal and it logs the calories and macros for you. Rated 4.6 on the US App Store.</dd>
                    </div>
                    <div>
                      <dt><a class="link" href="https://cradle.zorest.com" target="_blank" rel="noopener noreferrer">Cradle</a></dt>
                      <dd>A baby sleep and care tracker for iPhone, iPad and Apple Watch. It learns your baby’s pattern and predicts the next nap.</dd>
                    </div>
                  </dl>
                </div>
              </div>
            </div>
          </li>

          <li class="node" data-node data-reveal style="--i:1">
            <div class="node__left">
              <span class="node__years">2023 to 2025</span>
              <span class="node__dur">2 yr</span>
            </div>
            <span class="node__dot" aria-hidden="true"></span>
            <div class="node__body">
              <h3 class="node__h"><button class="node__toggle" type="button" aria-expanded="false" aria-controls="node-xena">XENA Intelligence</button> <span class="node__role">Product Engineer</span></h3>
              <p class="node__lead">A Techstars ’22 company building an AI growth platform for brands selling on Amazon, Walmart and Shopify.</p>
              <div class="node__more" id="node-xena">
                <div class="node__inner">
                  <p>I built the multi-tenant SaaS core with per-tenant data isolation, shipped LLM features on vector databases, documented the APIs with OpenAPI, and built the analytics dashboards for brand performance data. I also engineered a data lakehouse on S3, Athena, RDS and SQS, with Airflow running the workflows, and led the front end for a suite of tools used by top brands in the US and India.</p>
                  <p class="node__note">I started here as a full-stack intern from July 2022 to March 2023, with a short mobile-developer internship at ILIN Analytica over that winter.</p>
                </div>
              </div>
            </div>
          </li>

          <li class="node" data-node data-reveal style="--i:2">
            <div class="node__left">
              <span class="node__years">2021 to 2023</span>
              <span class="node__dur">2 yr 3 mo</span>
            </div>
            <span class="node__dot" aria-hidden="true"></span>
            <div class="node__body">
              <h3 class="node__h"><button class="node__toggle" type="button" aria-expanded="false" aria-controls="node-revyu">Revyu</button> <span class="node__role">Co-founder</span></h3>
              <p class="node__lead">My first company, started while I was still at university. We built Shopify apps for merchants.</p>
              <div class="node__more" id="node-revyu">
                <div class="node__inner">
                  <p>I led the front-end team and worked directly with the Shopify APIs to build tools that fit into a merchant’s day without getting in the way.</p>
                </div>
              </div>
            </div>
          </li>

        </ol>
      </section>

      <section class="nodes nodes--edu" id="education" aria-labelledby="edu-h">
        <h2 class="head nodes__h" id="edu-h" data-reveal>Where I studied</h2>
        <ol class="nodes__list">
          <li class="node" data-node data-reveal style="--i:0">
            <div class="node__left">
              <span class="node__years">2019 to 2023</span>
              <span class="node__dur">4 yr</span>
            </div>
            <span class="node__dot" aria-hidden="true"></span>
            <div class="node__body">
              <h3 class="node__h"><button class="node__toggle" type="button" aria-expanded="false" aria-controls="node-cusat">CUSAT</button> <span class="node__role">B.Tech, Computer Science</span></h3>
              <p class="node__lead">School of Engineering, Cochin University of Science and Technology.</p>
              <div class="node__more" id="node-cusat">
                <div class="node__inner">
                  <p>Outside class I was technical head at TEDxCUSAT, organised Make-A-Ton 5.0, the university’s flagship hackathon, worked on the technical team for Dhishna, and our team won the Spheron track at Unfold ’22, run by Devfolio and CoinDCX.</p>
                </div>
              </div>
            </div>
          </li>
        </ol>
      </section>

      <section class="stack" id="stack" aria-labelledby="stack-h">
        <h2 class="head stack__h" id="stack-h" data-reveal>What I work with</h2>
        <p class="stack__aside" data-reveal style="--i:1">I pick boring, well-documented tools and spend the budget on the product. Most days that means TypeScript end to end, Postgres, and whichever model provider is cheapest for the job that week.</p>
        <ul class="stack__list" data-reveal="list">
          {stack.map((s) => (
            <li class="stack__item" tabindex="0">
              <span class="stack__name">{s.name}</span>
              <span class="stack__note">{s.note}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="made" id="made" aria-labelledby="made-h">
        <h2 class="head made__h" id="made-h" data-reveal>Earlier things I made</h2>
        <p class="made__aside" data-reveal style="--i:1">Side projects from university, mostly built for the people around me. They still run, so they still count.</p>
        <ul class="made__list" data-reveal="list">
          <li><div class="made__row"><span>Sahaay</span><span>Helped people find the resources they needed during the pandemic.</span><span>2020</span></div></li>
          <li><div class="made__row"><span>MessedUp</span><span>Ran the mess for my college hostel.</span><span>2021</span></div></li>
          <li><div class="made__row"><span>D-Crowdfunding</span><span>A decentralised crowdfunding app.</span><span>2022</span></div></li>
        </ul>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-h">
        <h2 class="contact__h" id="contact-h" data-reveal>Reach me</h2>
        <ul class="rows" data-reveal="rows">
          <li><a class="row" href="mailto:ajal.p1999@gmail.com?subject=Hello%20Ajal"><span>ajal.p1999@gmail.com</span><svg class="row__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12h17M13 5l7 7-7 7"/></svg></a></li>
          <li><a class="row" href="https://www.linkedin.com/in/ajal/" target="_blank" rel="noopener noreferrer"><span>LinkedIn</span><svg class="row__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12h17M13 5l7 7-7 7"/></svg></a></li>
          <li><a class="row" href="https://github.com/Ajal333" target="_blank" rel="noopener noreferrer"><span>GitHub</span><svg class="row__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12h17M13 5l7 7-7 7"/></svg></a></li>
          <li><a class="row" href="https://linktr.ee/ajal.p" target="_blank" rel="noopener noreferrer"><span>Linktree</span><svg class="row__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12h17M13 5l7 7-7 7"/></svg></a></li>
          <li><span class="row row--still"><span>Palakkad, Kerala</span></span></li>
        </ul>
      </section>
    </main>

    <footer class="foot">
      <div class="foot__invitation">
        <p class="foot__invite">Want to build something?</p>
        <a class="button button--inverse" href="mailto:ajal.p1999@gmail.com?subject=Hello%20Ajal">Email me</a>
      </div>
      <ul class="foot__links">
          <li><a class="link" href="https://www.linkedin.com/in/ajal/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a class="link" href="https://github.com/Ajal333" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a class="link" href="https://twitter.com/Ajal_333" target="_blank" rel="noopener noreferrer">X</a></li>
      </ul>
      <p class="foot__legal">© {new Date().getFullYear()} Ajal P. Built with Astro.</p>
    </footer>
  </div>

  <script>
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const nodes = Array.from(document.querySelectorAll<HTMLElement>('[data-node]'));

    // One node open at a time: the one nearest the pulse, or the one you point at / press.
    const open = (node: HTMLElement, count = true) => {
      nodes.forEach((n) => {
        const on = n === node;
        n.classList.toggle('is-open', on);
        n.querySelector('.node__toggle')?.setAttribute('aria-expanded', String(on));
      });
      if (count && !node.dataset.counted) {
        node.dataset.counted = '1';
        roll(node);
      }
    };
    let pinned: HTMLElement | null = null;
    let hovering = false;
    const fine = matchMedia('(hover: hover)');
    nodes.forEach((n) => {
      n.querySelector('.node__toggle')?.addEventListener('click', () => {
        pinned = pinned === n ? null : n;
        open(n);
      });
      n.addEventListener('pointerenter', () => { if (fine.matches) { hovering = true; open(n); } });
      n.addEventListener('pointerleave', () => { hovering = false; });
      n.addEventListener('focusin', () => open(n));
    });

    // The pulse rides the line; the node whose dot it passes opens.
    const pulse = document.querySelector<HTMLElement>('.pulse');
    let ticking = false;
    const track = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      const y = p * (innerHeight - 140);
      if (pulse) pulse.style.setProperty('--y', `${y}px`);
      if (pinned || hovering) return;
      let best: HTMLElement | null = null;
      let bestD = Infinity;
      for (const n of nodes) {
        const r = n.querySelector('.node__dot')!.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - (y + 70));
        if (d < bestD) { bestD = d; best = n; }
      }
      if (best && bestD < innerHeight * 0.3) open(best);
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(track); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    track();
    open(nodes[0], false);

    // Reveals, once.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

    // Figures roll into place once, from the real value in the HTML.
    function roll(host: HTMLElement) {
      if (reduced) return;
      host.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const end = parseFloat(el.dataset.count!);
        const dec = Number(el.dataset.dec || 0);
        const suffix = el.dataset.suffix || '';
        const t0 = performance.now();
        const dur = 700;
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / dur);
          const ease = 1 - Math.pow(1 - k, 3);
          el.textContent = (end * ease).toFixed(dec) + suffix;
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }
  </script>
</Base>
