---
import Base from '../layouts/Base.astro';
---

<Base title="Not here · Ajal P" description="That page isn’t on my site. Head back to the front page." path="/404" noindex>
  <div class="page">
    <div class="line" aria-hidden="true"></div>
    <header class="top">
      <a class="top__mark" href="/">Ajal P</a>
      <nav class="top__nav" aria-label="Sections">
        <a class="link" href="/#work">Work</a>
        <a class="link" href="/#stack">Stack</a>
        <a class="link" href="/#contact">Contact</a>
      </nav>
      <a class="button top__cta" href="mailto:ajal.p1999@gmail.com?subject=Hello%20Ajal">Email me</a>
    </header>
    <main class="hero lost">
      <h1 class="hero__statement">That page isn’t here.</h1>
      <p class="hero__intro">Nothing hangs on the line at this address. Try the front page, or email me if a link I sent you is broken.</p>
      <a class="button hero__cta lost__cta" href="/">Back to my front page</a>
    </main>
  </div>
</Base>

<style>
  .lost__cta { display: inline-flex; }
</style>
